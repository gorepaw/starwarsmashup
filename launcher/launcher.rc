#include <winver.h>

// Asks Windows for no elevation: the launcher installs per user.
1 24 "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,1
PRODUCTVERSION 0,1,0,1
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Star Wars Mashup launcher"
      VALUE "ProductName", "Star Wars Mashup (unofficial fan project)"
      VALUE "FileVersion", "0.1.0.1"
      VALUE "ProductVersion", "0.1.0.1"
      VALUE "OriginalFilename", "launcher.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
